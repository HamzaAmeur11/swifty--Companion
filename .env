


# These are read by app.config.js → Constants.expoConfig.extra (web / dev builds)
FT_CLIENT_ID=u-xxx
FT_CLIENT_SECRET=s-x 
# These are inlined by Metro bundler — work in ALL environments including Expo Go mobile
# Must be prefixed with EXPO_PUBLIC_ to be accessible in client code
EXPO_PUBLIC_FT_CLIENT_ID=u-xxx
EXPO_PUBLIC_FT_CLIENT_SECRET=s-x